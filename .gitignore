.DS_Store
Thumbs.db

# ---- Project data (large / generated) ----
# KITTI .bin frames and any raw point clouds are NOT committed.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Live environmental-sensor snapshot/history written by the serial bridge.
data/live/*
!data/live/.gitkeep

# Pretrained model weights
models/*
!models/.gitkeep

# Generated visualization / benchmark outputs
outputs/
*.html
*.png
*.jpg
!docs/**/*.png
!docs/**/*.jpg

# Streamlit
.streamlit/secrets.toml

